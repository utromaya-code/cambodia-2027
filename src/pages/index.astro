---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SiteNav from '../components/SiteNav.astro';
import TrustStrip from '../components/TrustStrip.astro';
import VisualManifesto from '../components/VisualManifesto.astro';
import TripIntro from '../components/TripIntro.astro';
import KeyFacts from '../components/KeyFacts.astro';
import WhyCambodia from '../components/WhyCambodia.astro';
import Escape from '../components/Escape.astro';
import RideVsRoad from '../components/RideVsRoad.astro';
import Bike from '../components/Bike.astro';
import RouteMap from '../components/RouteMap.astro';
import Timeline from '../components/Timeline.astro';
import Uniqueness from '../components/Uniqueness.astro';
import Leaders from '../components/Leaders.astro';
import PastTrips from '../components/PastTrips.astro';
import Practice from '../components/Practice.astro';
import Pricing from '../components/Pricing.astro';
import Island from '../components/Island.astro';
import Faq from '../components/Faq.astro';
import LeadForm from '../components/LeadForm.astro';
import Footer from '../components/Footer.astro';
import MobileStickyCta from '../components/MobileStickyCta.astro';

import { trip } from '../data/trip';
import { pricing } from '../data/pricing';
import { routePoints } from '../data/route';
import { days } from '../data/days';
import { whyCambodia, practice, accommodation, pastTrips } from '../data/sections';
import { island } from '../data/island';
import { bike, bikeUpgrade } from '../data/bike';
import { faq } from '../data/faq';

const title = 'Камбоджа на байках 2027 — авторское путешествие от Ангкора до моря';
const description =
  '26 февраля — 8 марта 2027. Авторская экспедиция через Камбоджу: Ангкор, Баттамбанг, Тонлесап, Кириром, Кампот, Бокор и побережье. На байке или микроавтобусе.';

/** Все ключи снимков страницы — по ним подвал собирает список авторов. */
const photoKeys = [
  'hero',
  ...pastTrips.photos.map((p) => p.image),
  'escape',
  'sunset-mekong',
  'palms-field',
  'jungle-river',
  'waterfall-jungle',
  bike.image,
  ...bikeUpgrade.photos.map((p) => p.image),
  practice.image,
  accommodation.image,
  island.image,
  ...whyCambodia.cards.map((c) => c.image),
  ...routePoints.flatMap((p) => [p.image, ...(p.gallery ?? [])]),
  ...days.map((d) => d.image),
  'leader-ilya',
  'leader-andrey',
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'TouristTrip',
    name: 'Камбоджа: Дорога на юг',
    description:
      'Десятидневное авторское путешествие через Камбоджу от Ангкора до побережья: Ангкор, Пном Кулен, Бенг Мелеа, Баттамбанг, Тонлесап, Кириром, Кампот, Бокор, Реам, Сиануквиль. Пройти маршрут можно на мотоцикле или на микроавтобусе.',
    touristType: ['Мотопутешествия', 'Приключенческий туризм', 'Авторские путешествия'],
    startDate: trip.dates.start,
    endDate: trip.dates.end,
    provider: {
      '@type': 'Organization',
      name: 'Vsemaya',
      url: trip.contacts.telegram,
    },
    itinerary: {
      '@type': 'ItemList',
      numberOfItems: routePoints.length,
      itemListElement: routePoints.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: `${p.name} (${p.latin})`,
      })),
    },
    offers: pricing.options.map((o) => ({
      '@type': 'Offer',
      name: o.eyebrow,
      price: String(o.price),
      priceCurrency: o.currency,
      availability: 'https://schema.org/LimitedAvailability',
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<Base
  title={title}
  description={description}
  ogImage="og-image.jpg"
  structuredData={structuredData}
>
  <SiteNav />
  <Hero />

  <main id="main">
    <!-- Полоса доверия внутри main, а не между <header> и <main>: skip-link
         ведёт на #main, и снаружи её пропустил бы каждый, кто идёт с клавиатуры. -->
    <TrustStrip />
    <VisualManifesto />
    <TripIntro />
    <KeyFacts />
    <WhyCambodia />
    <Escape />
    <RouteMap />
    <RideVsRoad />
    <Bike />
    <Timeline />
    <Uniqueness />
    <Leaders />
    <PastTrips />
    <Practice />
    <Pricing />
    <Island />
    <Faq />
    <LeadForm />
  </main>

  <Footer photoKeys={photoKeys} />
  <MobileStickyCta />
</Base>

<script>
  import { bindAnalytics } from '../scripts/analytics';
  import { initReveal } from '../scripts/reveal';

  bindAnalytics();
  initReveal();
</script>
