---
import Photo from './Photo.astro';
import { hero, trip } from '../data/trip';
import { pricing } from '../data/pricing';

const [moto, road] = pricing.options;
---

<header data-hero class="hero">
  <div class="hero__grid">
    <div class="hero__visual" aria-hidden="true">
      <Photo
        src="hero"
        alt=""
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        widths={[640, 1000, 1400, 1900]}
        class="hero__photo hero__photo--mobile"
      />
      <Photo
        src="angkor-organizer-aerial"
        alt=""
        sizes="(min-width: 60rem) 56vw, 100vw"
        loading="eager"
        fetchpriority="high"
        widths={[720, 1000, 1400]}
        class="hero__photo hero__photo--desktop"
      />

      <p class="hero__route">Сиемреап <span>→</span> южное побережье</p>
    </div>

    <div class="hero__copy">
      <nav class="hero__nav" aria-label="Навигация по странице">
        <a class="hero__brand" href="#main">Камбоджа · 2027</a>
        <div class="hero__links">
          <a href="#marshrut">Маршрут</a>
          <a href="#vedushchie">Ведущие</a>
          <a href="#stoimost">Стоимость</a>
        </div>
      </nav>

      <div class="hero__content">
        <p data-hero-anim class="hero__eyebrow">
          Авторское путешествие · {trip.dates.totalDays} дней
        </p>

        <h1 data-hero-anim class="hero__title">
          <span>{trip.title}</span>
          <small>{trip.subtitle}</small>
        </h1>

        <p data-hero-anim class="hero__lead">{hero.lead}</p>

        <dl data-hero-anim class="hero__facts">
          <div>
            <dt>Когда</dt>
            <dd>26 фев — 8 мар</dd>
          </div>
          <div>
            <dt>Как ехать</dt>
            <dd>Байк или микроавтобус</dd>
          </div>
        </dl>

        <div data-hero-anim class="hero__offer">
          <div class="hero__price">
            <span>от</span>
            <strong>{road.priceHuman}</strong>
          </div>
          <p>{moto.priceHuman} на байке · {road.priceHuman} в микроавтобусе</p>
        </div>

        <div data-hero-anim class="hero__actions">
          <a data-analytics="hero_cta_click" href="#zayavka" class="hero__cta">
            {hero.cta}
            <span aria-hidden="true">→</span>
          </a>
          <a href="#marshrut" class="hero__secondary">Смотреть маршрут</a>
        </div>

        <p data-hero-anim class="hero__note">{hero.note}</p>
      </div>
    </div>
  </div>
</header>

<style>
  .hero {
    min-height: 100svh;
    background: var(--marker);
    color: var(--ink);
  }

  .hero__grid {
    display: grid;
    min-height: 100svh;
    grid-template-rows: minmax(17rem, 38svh) auto;
  }

  .hero__visual {
    position: relative;
    min-width: 0;
    overflow: hidden;
    background: var(--jungle);
  }

  :global(.hero__photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  :global(.hero__photo--desktop) {
    display: none;
  }

  .hero__route {
    position: absolute;
    inset: auto var(--gutter) 1rem auto;
    padding: 0.55rem 0.75rem;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }

  .hero__route span {
    margin-inline: 0.35rem;
    color: var(--marker);
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 0 var(--gutter) 2.2rem;
    background: var(--marker);
  }

  .hero__nav {
    display: flex;
    min-height: 4rem;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 25%, transparent);
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero__brand {
    text-decoration: none;
  }

  .hero__links {
    display: none;
  }

  .hero__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    padding-top: clamp(1.8rem, 5vw, 4rem);
  }

  .hero__eyebrow {
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hero__title {
    margin-top: 0.8rem;
    font-size: clamp(3.6rem, 15vw, 6rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 0.83;
    text-transform: uppercase;
  }

  .hero__title span,
  .hero__title small {
    display: block;
  }

  .hero__title small {
    width: fit-content;
    margin-top: 0.8rem;
    padding: 0.22em 0.3em 0.28em;
    background: var(--laterite);
    color: var(--paper);
    font-size: 0.42em;
    letter-spacing: 0.01em;
    line-height: 1;
  }

  .hero__lead {
    max-width: 48ch;
    margin-top: 1.35rem;
    font-size: clamp(1rem, 2.8vw, 1.18rem);
    font-weight: 550;
    line-height: 1.48;
  }

  .hero__facts {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 1rem;
    margin-top: 1.35rem;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--ink) 25%, transparent);
  }

  .hero__facts dt {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.65;
  }

  .hero__facts dd {
    margin: 0.2rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    line-height: 1.15;
  }

  .hero__offer {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.35rem 1rem;
    margin-top: 1.4rem;
  }

  .hero__price {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    white-space: nowrap;
  }

  .hero__price span {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .hero__price strong {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 7vw, 3.8rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 0.9;
  }

  .hero__offer > p {
    max-width: 18rem;
    padding-bottom: 0.2rem;
    font-size: 0.76rem;
    line-height: 1.35;
    opacity: 0.72;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem 1.25rem;
    margin-top: 1.25rem;
  }

  .hero__cta {
    display: inline-flex;
    min-height: 3.5rem;
    flex: 1 1 15rem;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 0.9rem 1.1rem;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .hero__cta span {
    color: var(--marker);
    font-size: 1.45rem;
    transition: transform 0.2s ease;
  }

  .hero__cta:hover {
    background: var(--laterite);
  }

  .hero__cta:hover span {
    transform: translateX(0.25rem);
  }

  .hero__secondary {
    font-size: 0.78rem;
    font-weight: 750;
    text-underline-offset: 0.25rem;
  }

  .hero__note {
    margin-top: 0.85rem;
    font-size: 0.74rem;
    line-height: 1.45;
    opacity: 0.66;
  }

  [data-hero-anim] {
    opacity: 0;
  }

  @media (min-width: 60rem) {
    .hero__grid {
      grid-template-columns: minmax(30rem, 44%) minmax(0, 56%);
      grid-template-rows: 100svh;
    }

    .hero__visual {
      grid-column: 2;
      grid-row: 1;
    }

    .hero__copy {
      grid-column: 1;
      grid-row: 1;
      padding: 0 clamp(2.5rem, 4.4vw, 5rem) 3rem;
    }

    :global(.hero__photo--mobile) {
      display: none;
    }

    :global(.hero__photo--desktop) {
      display: block;
    }

    .hero__route {
      inset: auto 2rem 2rem auto;
      font-size: 0.84rem;
    }

    .hero__nav {
      min-height: 5rem;
    }

    .hero__links {
      display: flex;
      gap: 1.2rem;
    }

    .hero__links a {
      text-decoration: none;
      transition: opacity 0.2s ease;
    }

    .hero__links a:hover {
      opacity: 0.55;
    }

    .hero__content {
      padding-top: 1.8rem;
    }

    .hero__title {
      font-size: clamp(4.8rem, 7.2vw, 7.8rem);
    }

    .hero__lead {
      margin-top: 1.8rem;
    }

    .hero__facts {
      margin-top: 1.6rem;
    }

    .hero__cta {
      flex: 0 1 18rem;
    }
  }

  @media (max-height: 48rem) and (min-width: 60rem) {
    .hero__nav {
      min-height: 4rem;
    }

    .hero__title {
      font-size: clamp(4rem, 6.4vw, 6.4rem);
    }

    .hero__lead,
    .hero__facts,
    .hero__offer {
      margin-top: 1rem;
    }

    .hero__actions {
      margin-top: 0.9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-hero-anim] {
      opacity: 1;
    }

    .hero__cta,
    .hero__cta span {
      transition: none;
    }
  }
</style>

<noscript>
  <style>
    [data-hero-anim] {
      opacity: 1 !important;
    }
  </style>
</noscript>

<script>
  import { gsap } from 'gsap';

  const root = document.querySelector<HTMLElement>('[data-hero]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root && !reduceMotion) {
    const targets = root.querySelectorAll<HTMLElement>('[data-hero-anim]');
    gsap.fromTo(
      targets,
      { opacity: 0, y: 18 },
      { opacity: 1, y: 0, duration: 0.72, ease: 'power3.out', stagger: 0.07, delay: 0.08 },
    );
  }
</script>
