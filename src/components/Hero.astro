---
import Photo from './Photo.astro';
import Marker from './Marker.astro';
import { hero } from '../data/trip';
import { pricing } from '../data/pricing';
import { bike } from '../data/bike';

const [moto, road] = pricing.options;
---

<!--
  Первый экран — кадр рассвета над Ангкором во всю ширину.

  Прошлая версия делила экран пополам: текст на белом слева, фотография
  справа. На кадре с утрамбованной грунтовкой это работало, но с рассветом
  над Ангкором — нет: снимок держится на масштабе неба и отражении, и в
  половине экрана он просто перестаёт читаться. Поэтому фотография
  разворачивается на весь экран, а текст ложится поверх.

  Затемнение снизу здесь не «атмосферный градиент», а обеспечение
  читаемости: в нижней трети кадра силуэт храма и отражение, и без
  подложки белый текст на них рассыпается. Небо сверху не трогаем —
  ради него всё и затевалось.
-->
<header data-hero class="relative isolate min-h-[100svh] overflow-hidden bg-graphite text-paper">
  <Photo
    src="hero"
    alt="Рассвет над Ангкор-Ватом: оранжевое небо и силуэты башен, отражённые в воде пруда"
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    widths={[640, 1000, 1400, 1900, 2400]}
    class="absolute inset-0 h-full w-full"
  />

  <!--
    Здесь стоял <video> с /video/hero.mp4, которого нет в проекте. Браузер
    честно ходил за ним при каждой загрузке и получал 404 — впустую, потому
    что кадр всё равно рисует <Photo> под ним. Вернуть тег имеет смысл
    вместе с реальным файлом; требования к ролику — в CONTENT_NEEDED.md.
  -->

  <div
    class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-transparent"
    aria-hidden="true">
  </div>

  <div
    class="relative mx-auto flex min-h-[100svh] w-full max-w-[100rem] flex-col justify-end px-[var(--gutter)] pt-24 pb-12 lg:pb-20"
  >
    <p
      data-hero-anim
      class="font-body text-xs font-semibold tracking-[0.22em] text-gold-soft uppercase"
    >
      {hero.poster.dates} · {hero.poster.duration}
    </p>

    <h1 data-hero-anim class="mt-4 font-display leading-[0.88] uppercase">
      <span class="block text-[clamp(3.2rem,1.8rem+9vw,8.5rem)] tracking-[-0.02em]">
        {hero.kicker}
      </span>
      <Marker tilt={-0.6} class="mt-3 text-[clamp(1.5rem,0.85rem+3.2vw,3.4rem)] text-graphite">
        {hero.title}
      </Marker>
    </h1>

    <p
      data-hero-anim
      class="mt-7 max-w-[44ch] text-[length:var(--step-0)] leading-[1.5] text-paper/90"
    >
      {hero.lead}
    </p>

    <p
      data-hero-anim
      class="mt-5 font-body text-xs font-semibold tracking-[0.18em] text-paper/70 uppercase"
    >
      {hero.poster.route} · {bike.model}
    </p>

    <!-- Цена — крупные строки, без карточек и рамок -->
    <div data-hero-anim class="mt-6 flex flex-wrap items-baseline gap-x-8 gap-y-2">
      <span class="inline-flex flex-wrap items-baseline gap-x-3">
        <span class="font-display text-[length:var(--step-3)] leading-none text-marker">
          {moto.priceHuman}
        </span>
        <span class="text-[length:var(--step--1)] tracking-[0.1em] text-paper/75 uppercase">
          на байке
        </span>
      </span>
      <span class="inline-flex flex-wrap items-baseline gap-x-3">
        <span class="font-display text-[length:var(--step-3)] leading-none text-marker">
          {road.priceHuman}
        </span>
        <span class="text-[length:var(--step--1)] tracking-[0.1em] text-paper/75 uppercase">
          на микроавтобусе
        </span>
      </span>
    </div>

    <!-- Вторичное действие рядом с основным: посетителю, который ещё не готов
         писать, нужен способ сначала посмотреть дорогу, а не уходить со
         страницы. Ссылка намеренно текстовая — вторая кнопка отобрала бы
         часть внимания у заявки. -->
    <div data-hero-anim class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
      <a
        data-analytics="hero_cta_click"
        href="#zayavka"
        class="group relative inline-flex w-full items-center justify-center overflow-hidden bg-terracotta px-8 py-4 font-display text-base tracking-[0.1em] text-paper uppercase sm:w-auto"
      >
        <!-- Заливка при наведении: жёлтый выезжает слева направо, текст становится чёрным -->
        <span
          class="absolute inset-0 origin-left scale-x-0 bg-marker transition-transform duration-300 ease-out group-hover:scale-x-100"
          aria-hidden="true"></span>
        <span class="relative transition-colors duration-300 group-hover:text-graphite">
          {hero.cta}
        </span>
      </a>

      <a
        data-analytics="hero_route_click"
        href="#marshrut"
        class="font-body text-sm font-semibold tracking-[0.14em] text-paper/85 uppercase underline decoration-marker decoration-2 underline-offset-[0.4em] transition-colors hover:text-marker"
      >
        {hero.ctaSecondary}
      </a>
    </div>

    <p data-hero-anim class="mt-4 max-w-[46ch] text-[length:var(--step--1)] text-paper/70">
      {hero.note}
    </p>
  </div>
</header>

<style>
  /*
   * Начальное «скрытое» состояние задаём в CSS, а не в JS: иначе между
   * отрисовкой и запуском GSAP видна вспышка полностью проявленного текста.
   */
  [data-hero-anim] {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-hero-anim] {
      opacity: 1;
    }
  }
</style>

<noscript>
  <style>
    [data-hero-anim] {
      opacity: 1 !important;
    }
  </style>
</noscript>

<script>
  import { gsap } from 'gsap';

  const root = document.querySelector<HTMLElement>('[data-hero]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root && !reduceMotion) {
    const targets = root.querySelectorAll<HTMLElement>('[data-hero-anim]');
    gsap.fromTo(
      targets,
      { opacity: 0, y: 24 },
      { opacity: 1, y: 0, duration: 0.85, ease: 'power3.out', stagger: 0.08, delay: 0.12 },
    );
  }
</script>
