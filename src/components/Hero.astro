---
import Photo from './Photo.astro';
import { hero, trip } from '../data/trip';
import { pricing } from '../data/pricing';

const [moto, road] = pricing.options;
---

<header data-hero class="hero">
  <Photo
    src="hero-road"
    alt="Группа мотоциклистов едет по красной дороге через тропическую Камбоджу на закате"
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    widths={[640, 1000, 1400, 1900, 2400]}
    class="hero__photo"
  />

  <div class="hero__scrim" aria-hidden="true"></div>

  <nav class="hero__nav" aria-label="Навигация по странице">
    <a class="hero__brand" href="#main">Камбоджа · 2027</a>
    <div class="hero__links">
      <a href="#marshrut">Маршрут</a>
      <a href="#vedushchie">Ведущие</a>
      <a href="#stoimost">Стоимость</a>
    </div>
  </nav>

  <div class="hero__content">
    <p data-hero-anim class="hero__eyebrow">
      {trip.dates.humanShort} · {trip.dates.totalDays} дней
    </p>

    <h1 data-hero-anim class="hero__title">
      <span>{trip.title}</span>
      <small>{trip.subtitle}</small>
    </h1>

    <p data-hero-anim class="hero__lead">{hero.lead}</p>

    <p data-hero-anim class="hero__route">
      Сиемреап <span aria-hidden="true">→</span> южное побережье
      <i>Байк или микроавтобус</i>
    </p>

    <div data-hero-anim class="hero__offer">
      <p class="hero__price"><span>от</span> {road.priceHuman}</p>
      <p class="hero__price-note">
        {moto.priceHuman} на байке · {road.priceHuman} в микроавтобусе
      </p>
    </div>

    <div data-hero-anim class="hero__actions">
      <a data-analytics="hero_cta_click" href="#zayavka" class="hero__cta">
        {hero.cta}
        <span aria-hidden="true">→</span>
      </a>
      <a data-analytics="hero_route_click" href="#marshrut" class="hero__secondary">
        Смотреть маршрут
      </a>
    </div>

    <p data-hero-anim class="hero__note">{hero.note}</p>
  </div>

  <a href="#zachem" class="hero__scroll" aria-label="Перейти к описанию путешествия">
    <span aria-hidden="true"></span>
  </a>
</header>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    overflow: hidden;
    background: #28160d;
    color: var(--paper);
  }

  :global(.hero__photo) {
    position: absolute;
    z-index: -3;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  :global(.hero__photo img) {
    object-position: 44% center;
    filter: saturate(0.96) brightness(1.02);
    transform: scale(1.01);
  }

  .hero__scrim {
    position: absolute;
    z-index: -2;
    inset: 0;
    background:
      linear-gradient(
        to top,
        rgb(22 12 7 / 0.92) 0%,
        rgb(24 13 8 / 0.76) 43%,
        rgb(31 17 9 / 0.35) 70%,
        rgb(38 22 11 / 0.05) 100%
      );
  }

  .hero__nav {
    position: absolute;
    z-index: 2;
    inset: 0 var(--gutter) auto;
    display: flex;
    min-height: 4.75rem;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgb(255 253 247 / 0.28);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .hero__brand,
  .hero__links a {
    text-decoration: none;
  }

  .hero__links {
    display: none;
  }

  .hero__content {
    display: flex;
    width: min(100% - var(--gutter) * 2, 100rem);
    min-height: 100svh;
    margin-inline: auto;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: 7rem;
    padding-bottom: clamp(2.2rem, 7vw, 4.5rem);
  }

  .hero__eyebrow {
    color: #f5c9b4;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  .hero__title {
    margin-top: 0.85rem;
    font-size: clamp(4rem, 17vw, 7rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 0.84;
    text-transform: uppercase;
  }

  .hero__title span,
  .hero__title small {
    display: block;
  }

  .hero__title small {
    margin-top: 0.8rem;
    color: #ffd6a3;
    font-family: var(--font-body);
    font-size: 0.29em;
    font-weight: 650;
    letter-spacing: 0.08em;
    line-height: 1.1;
  }

  .hero__lead {
    max-width: 45ch;
    margin-top: 1.45rem;
    color: rgb(255 253 247 / 0.9);
    font-size: clamp(1rem, 2.8vw, 1.16rem);
    font-weight: 480;
    line-height: 1.52;
  }

  .hero__route {
    display: flex;
    max-width: 46rem;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.65rem;
    margin-top: 1.3rem;
    color: rgb(255 253 247 / 0.72);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero__route span {
    color: #f4a37f;
  }

  .hero__route i {
    padding-left: 0.65rem;
    border-left: 1px solid rgb(255 253 247 / 0.28);
    font-style: normal;
  }

  .hero__offer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 1rem;
    margin-top: 1.45rem;
  }

  .hero__price {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    color: #ffd6a3;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 7vw, 3.6rem);
    letter-spacing: -0.025em;
    line-height: 1;
  }

  .hero__price span {
    color: rgb(255 253 247 / 0.62);
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero__price-note {
    max-width: 18rem;
    color: rgb(255 253 247 / 0.62);
    font-size: 0.74rem;
    line-height: 1.4;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 1.35rem;
  }

  .hero__cta {
    display: inline-flex;
    min-height: 3.45rem;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 0.9rem 1.15rem;
    background: #b94c35;
    color: var(--paper);
    font-family: var(--font-display);
    font-size: 1.02rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
    box-shadow: 0 0.5rem 1.8rem rgb(28 17 24 / 0.2);
    transition: background 0.2s ease;
  }

  .hero__cta span {
    color: #ffd6a3;
    font-size: 1.35rem;
    transition: transform 0.2s ease;
  }

  .hero__cta:hover {
    background: #9f3c2b;
  }

  .hero__cta:hover span {
    transform: translateX(0.25rem);
  }

  .hero__secondary {
    color: rgb(255 253 247 / 0.88);
    font-size: 0.76rem;
    font-weight: 700;
    text-underline-offset: 0.3rem;
  }

  .hero__note {
    max-width: 42ch;
    margin-top: 0.85rem;
    color: rgb(255 253 247 / 0.58);
    font-size: 0.73rem;
    line-height: 1.45;
  }

  .hero__scroll {
    display: none;
  }

  [data-hero-anim] {
    opacity: 0;
  }

  @media (min-width: 40rem) {
    .hero__cta {
      width: auto;
      min-width: 18rem;
    }
  }

  @media (min-width: 60rem) {
    :global(.hero__photo img) {
      object-position: center;
    }

    .hero__scrim {
      background:
        linear-gradient(
          to right,
          rgb(20 11 7 / 0.84) 0%,
          rgb(23 13 8 / 0.68) 31%,
          rgb(31 17 9 / 0.28) 53%,
          transparent 72%
        ),
        linear-gradient(
          to top,
          rgb(20 11 7 / 0.46) 0%,
          rgb(27 15 8 / 0.12) 48%,
          transparent 76%
        );
    }

    .hero__nav {
      inset-inline: max(var(--gutter), calc((100vw - 100rem) / 2));
      min-height: 5.3rem;
    }

    .hero__links {
      display: flex;
      gap: 1.7rem;
    }

    .hero__links a {
      color: rgb(255 253 247 / 0.76);
      transition: color 0.2s ease;
    }

    .hero__links a:hover {
      color: var(--paper);
    }

    .hero__content {
      justify-content: center;
      padding-top: 7rem;
      padding-bottom: 3rem;
    }

    .hero__title {
      max-width: 9ch;
      font-size: clamp(6.5rem, 10vw, 10rem);
    }

    .hero__lead {
      margin-top: 1.8rem;
    }

    .hero__scroll {
      position: absolute;
      bottom: 1.7rem;
      left: 50%;
      display: block;
      width: 2rem;
      height: 2rem;
      transform: translateX(-50%);
    }

    .hero__scroll span {
      display: block;
      width: 0.8rem;
      height: 0.8rem;
      margin: 0.3rem auto 0;
      border-right: 1px solid rgb(255 253 247 / 0.75);
      border-bottom: 1px solid rgb(255 253 247 / 0.75);
      transform: rotate(45deg);
    }
  }

  @media (max-height: 47rem) and (min-width: 60rem) {
    .hero__title {
      font-size: clamp(5.2rem, 8vw, 7.5rem);
    }

    .hero__lead,
    .hero__route,
    .hero__offer {
      margin-top: 1rem;
    }

    .hero__actions {
      margin-top: 0.9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-hero-anim] {
      opacity: 1;
    }

    .hero__cta,
    .hero__cta span {
      transition: none;
    }
  }
</style>

<noscript>
  <style>
    [data-hero-anim] {
      opacity: 1 !important;
    }
  </style>
</noscript>

<script>
  import { gsap } from 'gsap';

  const root = document.querySelector<HTMLElement>('[data-hero]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root && !reduceMotion) {
    const targets = root.querySelectorAll<HTMLElement>('[data-hero-anim]');
    gsap.fromTo(
      targets,
      { opacity: 0, y: 18 },
      { opacity: 1, y: 0, duration: 0.78, ease: 'power3.out', stagger: 0.07, delay: 0.1 },
    );
  }
</script>
