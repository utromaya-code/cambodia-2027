---
import { getImage } from 'astro:assets';
import { intro } from '../data/trip';
import { getPhoto } from '../data/images';

/**
 * Короткая мысль под первым экраном.
 *
 * Здесь же раньше стояла табличка «Даты / Маршрут / Длительность / Как
 * ехать». Её забрал KeyFacts — блок ключевых фактов из пункта 4.4 ТЗ, —
 * и две одинаковые таблички шли подряд через один экран. Оставлена одна,
 * та, что полнее: она добавляет модель байка, апгрейд и латинские названия
 * городов, а недостающие факты умеет скрывать.
 *
 * Фон — размытые рисовые поля с сахарными пальмами. Экран был сплошным бежевым
 * полем с текстом в углу; размытая фотография даёт ему воздух и не мешает
 * читать. Размытие сделано на сборке (см. bg-intro.jpg), а не фильтром
 * в браузере: filter: blur() на картинке во весь экран стоит кадров при
 * прокрутке, а результат тот же.
 */
const bg = getPhoto('bg-intro');
const bgUrl = bg ? (await getImage({ src: bg, width: 1400, format: 'webp' })).src : null;
---

<section
  class="intro section"
  id="zachem"
  style={bgUrl ? `--bg-image:url(${bgUrl})` : undefined}
>
  <div class="wrap intro__grid">
    <h2 class="intro__title reveal">{intro.title}</h2>

    <div class="intro__body">
      <div class="prose prose--lead reveal">
        {intro.lines.map((line) => <p>{line}</p>)}
      </div>
    </div>
  </div>
</section>

<style>
  .intro {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  /*
   * 0.24 — потолок, при котором тёмный текст на бумаге гарантированно
   * держит контраст: даже под самым чёрным пикселем фон остаётся светлее
   * #c0b8ab, и ink на нём даёт больше 9:1.
   */
  .intro::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: var(--bg-image);
    background-size: cover;
    background-position: center;
    opacity: 0.24;
  }

  .intro__title {
    font-size: var(--step-4);
    text-transform: uppercase;
    max-width: 16ch;
  }

  .intro__body {
    margin-top: 2rem;
  }

  @media (min-width: 60rem) {
    .intro__grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem 4rem;
      align-items: start;
    }

    .intro__body {
      margin-top: 0;
    }
  }
</style>
