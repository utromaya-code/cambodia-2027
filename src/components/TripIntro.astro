---
import { intro } from '../data/trip';
---

<section class="intro section" id="zachem">
  <div class="wrap intro__grid">
    <h2 class="intro__title reveal">{intro.title}</h2>

    <div class="intro__body">
      <div class="prose prose--lead reveal">
        {intro.lines.map((line) => <p>{line}</p>)}
      </div>

    </div>
  </div>
</section>

<style>
  .intro__title {
    font-size: var(--step-4);
    text-transform: uppercase;
    max-width: 16ch;
  }

  .intro__body {
    margin-top: 2rem;
  }

  @media (min-width: 60rem) {
    .intro__grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem 4rem;
      align-items: start;
    }

    .intro__body {
      margin-top: 0;
    }
  }
</style>
