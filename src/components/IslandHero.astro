---
import Photo from './Photo.astro';
import { island } from '../data/island';

const { page } = island;
---

<header class="ihero">
  <div class="ihero__media">
    <Photo
      src="sea-paradise"
      alt="Бирюзовое море и белый песок Ко Ронга, скамейки в тени дерева на берегу"
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      widths={[640, 1000, 1400, 1900, 2400]}
    />
  </div>

  <div class="ihero__inner wrap">
    {/*
      Плашка под текстом — та же схема, что на первом экране ретрита.
      Раньше текст лежал прямо на снимке, и верхние строки приходились на
      светлое небо: подпись давала 1,4:1, заголовок — 1,8:1. Затемнять весь
      кадр ради них значило погасить бирюзу, на которую сюда и смотрят.
    */}
    <div class="ihero__plate">
      <p class="ihero__kicker">{page.kicker}</p>
      <h1 class="ihero__title">{page.title}</h1>
      <p class="ihero__lead">{page.lead}</p>

      <p class="ihero__price">
        <span>{island.price}</span>
        <em>{island.priceNote}</em>
      </p>

      <a class="btn ihero__cta" href="#zayavka" data-analytics="retreat_cta">
        {island.ctaPage}
      </a>
    </div>
  </div>
</header>

<style>
  .ihero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: 92svh;
    padding-block: clamp(4.5rem, 12vh, 8rem) clamp(3rem, 8vh, 5rem);
    color: #fff;
    background: var(--sea);
    overflow: hidden;
  }

  .ihero__media {
    position: absolute;
    inset: 0;
  }

  .ihero__media :global(.photo) {
    height: 100%;
  }

  /* Лёгкая плёнка связывает кадр с цветом плашки; контраст держит плашка */
  .ihero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(4 26 31 / 0.34) 0%,
      rgb(4 26 31 / 0.16) 45%,
      rgb(4 26 31 / 0.04) 78%,
      rgb(4 26 31 / 0.14) 100%
    );
  }

  .ihero__inner {
    position: relative;
    z-index: 1;
  }

  .ihero__plate {
    max-width: 40rem;
    padding: clamp(1.3rem, 4vw, 2.2rem) clamp(1.2rem, 3.5vw, 2.2rem);
    background: rgb(5 31 35 / 0.9);
  }

  .ihero__kicker {
    margin: 0 0 0.7rem;
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #ffd9a0;
  }

  .ihero__title {
    font-size: var(--step-4);
    text-transform: uppercase;
    line-height: 0.96;
  }

  @media (min-width: 62rem) {
    .ihero__title {
      font-size: var(--step-5);
      line-height: 0.94;
    }
  }

  .ihero__lead {
    max-width: 38ch;
    margin-top: 1.3rem;
    font-size: var(--step-1);
    line-height: 1.4;
    color: color-mix(in srgb, #fff 88%, transparent);
  }

  .ihero__price {
    display: grid;
    gap: 0.3rem;
    margin-top: 2rem;
  }

  .ihero__price span {
    font-family: var(--font-display);
    font-size: var(--step-4);
    line-height: 1;
  }

  .ihero__price em {
    font-style: normal;
    font-size: var(--step--1);
    color: color-mix(in srgb, #fff 82%, transparent);
  }

  .ihero__cta {
    margin-top: 1.7rem;
    width: 100%;
    background: #fff;
    color: var(--sea-ink);
  }

  .ihero__cta:hover {
    background: #ffe9c9;
  }

  @media (min-width: 40rem) {
    .ihero__cta {
      width: auto;
    }
  }
</style>
