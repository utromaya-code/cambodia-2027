---
import Photo from './Photo.astro';
import { bike, bikeUpgrade } from '../data/bike';
import { hasPhoto } from '../data/images';

/** Если снимка модели нет, секция аккуратно перестраивается в одну колонку. */
const bikePhotoReady = hasPhoto(bike.image);
---

<section class="bike section section--stone" id="bayk">
  <div class:list={['wrap', 'bike__grid', !bikePhotoReady && 'bike__grid--text-only']}>
    <div class="bike__text">
      <p class="kicker reveal">{bike.title}</p>
      <h2 class="bike__model reveal">{bike.model}</h2>
      <p class="bike__sub reveal">{bike.subtitle}</p>

      <div class="prose bike__prose reveal">
        {bike.description.map((line) => <p>{line}</p>)}
      </div>

      <dl class="bike__specs reveal">
        {
          bike.specs.map((spec) => (
            <div>
              <dt>{spec.label}</dt>
              <dd>{spec.value}</dd>
            </div>
          ))
        }
      </dl>

      <p class="bike__closing reveal">
        {bike.closing.map((line) => <span>{line}</span>)}
      </p>
    </div>

    <!-- Обёртка нужна ради .bike__photo { order: -1 }: scoped-стиль Astro
         не достаёт до корневого элемента дочернего компонента, поэтому на
         самом <Photo> правило молча не работало и снимок на десктопе
         оставался справа вместо левой колонки. -->
    {bikePhotoReady && (
    <div class="bike__photo reveal">
      <Photo
        src={bike.image}
        alt={bike.imageAlt}
        sizes="(min-width: 60rem) 48vw, 100vw"
        ratio="4 / 3"
      />
      <p class="bike__photo-note">{bike.imageNote}</p>
    </div>
    )}
  </div>

  <!-- Апгрейд за доплату. Отдельным блоком под основным байком, а не рядом
       с ним: базовая модель одна, и она не должна конкурировать за внимание
       с опцией, наличие которой ещё подтверждается. -->
  <div class="wrap upgrade reveal">
    <div class="upgrade__text">
      <p class="kicker">{bikeUpgrade.title}</p>
      <h3 class="upgrade__model">
        {bikeUpgrade.model}
        <span class="upgrade__price">{bikeUpgrade.surchargeHuman}</span>
      </h3>
      <div class="prose">
        {bikeUpgrade.lines.map((line) => <p>{line}</p>)}
      </div>
      <p class="upgrade__note">{bikeUpgrade.note}</p>
    </div>

    <div class="upgrade__photos">
      {
        bikeUpgrade.photos.map((p) => (
          <Photo src={p.image} alt={p.alt} sizes="(min-width: 60rem) 24vw, 45vw" ratio="4 / 3" />
        ))
      }
    </div>
  </div>
</section>

<style>
  .bike__grid {
    display: grid;
    gap: 2.5rem;
  }

  .bike__model {
    font-size: var(--step-3);
    text-transform: uppercase;
  }

  .bike__sub {
    margin-top: 0.7rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--laterite);
  }

  .bike__prose {
    max-width: 48ch;
    margin-top: 1.5rem;
    color: var(--ink-soft);
  }

  .bike__specs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
    gap: 1.2rem;
    margin: 2rem 0 0;
    padding-top: 1.6rem;
    border-top: 1px solid var(--rule);
  }

  .bike__specs dt {
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  .bike__specs dd {
    margin: 0.3rem 0 0;
    font-family: var(--font-display);
    font-size: var(--step-1);
  }

  .bike__closing {
    display: grid;
    gap: 0.15rem;
    margin-top: 2rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.2;
    text-transform: uppercase;
  }

  .bike__photo-note {
    margin-top: 0.65rem;
    color: var(--ink-mute);
    font-size: var(--step--1);
    line-height: 1.45;
  }

  /* Без фотографии колонка одна — иначе половина экрана остаётся пустой */
  .bike__grid--text-only {
    grid-template-columns: 1fr;
    max-width: 46rem;
  }

  @media (min-width: 60rem) {
    .bike__grid:not(.bike__grid--text-only) {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
    }

    .bike__photo {
      order: -1;
    }
  }

  /* --- Апгрейд на Himalayan --- */
  .upgrade {
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    padding-top: clamp(2rem, 5vw, 3rem);
    border-top: 1px solid var(--rule);
    display: grid;
    gap: 2rem;
  }

  .upgrade__model {
    font-size: var(--step-2);
    text-transform: uppercase;
    margin-block: 0.4rem 1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.7em;
  }

  .upgrade__price {
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 700;
    color: var(--laterite-ink);
    text-transform: none;
  }

  .upgrade__note {
    margin-top: 1rem;
    font-size: var(--step--1);
    color: var(--ink-mute);
  }

  .upgrade__photos {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.7rem;
  }

  @media (min-width: 60rem) {
    .upgrade {
      grid-template-columns: 1fr 1fr;
      gap: 3.5rem;
      align-items: center;
    }
  }
</style>
