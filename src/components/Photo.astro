---
import { Image } from 'astro:assets';
import { getPhoto } from '../data/images';

interface Props {
  /** Ключ файла в src/assets/photos (имя без расширения). */
  src: string;
  alt: string;
  /** Значение атрибута sizes — нужно, чтобы браузер брал подходящий срез. */
  sizes?: string;
  widths?: number[];
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
  /** Соотношение сторон кадра; без него подставляется исходное. */
  ratio?: string;
  /**
   * Качество webp. По умолчанию отдаём на откуп Astro; понижаем точечно там,
   * где картинка большая и грузится сразу, — прежде всего на первом экране:
   * она и есть LCP, и каждый лишний десяток килобайт виден в метрике.
   */
  quality?: number;
}

const {
  src,
  alt,
  sizes = '100vw',
  widths = [480, 800, 1200, 1800, 2400],
  loading = 'lazy',
  fetchpriority = 'auto',
  class: className = '',
  ratio,
  quality,
} = Astro.props;

const image = getPhoto(src);
const style = ratio ? `aspect-ratio:${ratio}` : undefined;

/**
 * Пустой alt означает декоративный снимок (фон под текстом). Astro вырезает
 * пустой атрибут из разметки, поэтому дополнительно ставим role="presentation" —
 * так программы чтения с экрана точно пропустят изображение.
 */
const decorative = alt.trim() === '';
---

{
  image ? (
    <div class:list={['photo', 'photo--grain', className]} style={style}>
      <Image
        src={image}
        alt={alt}
        widths={widths.filter((w) => w <= image.width)}
        sizes={sizes}
        loading={loading}
        fetchpriority={fetchpriority}
        decoding="async"
        quality={quality}
        role={decorative ? 'presentation' : undefined}
      />
    </div>
  ) : (
    /*
      Снимок ещё не подобран.

      В разработке показываем заметную заглушку с текстом — чтобы недостающий
      кадр было видно при вёрстке. В production не рендерим ничего: по ТЗ
      посетитель не должен видеть надписей «фотография будет добавлена»,
      а пустой прямоугольник выглядел бы как поломка. Секция, которой нужен
      кадр, обязана сама проверить hasPhoto() и перестроить раскладку.
    */
    import.meta.env.DEV && (
      <div
        class:list={['photo', 'photo--empty', className]}
        style={style}
        role="img"
        aria-label={alt}
      >
        <span>
          <b>DEV: кадр не подобран</b>
          {alt}
        </span>
      </div>
    )
  )
}

<style>
  .photo--empty {
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background: repeating-linear-gradient(
      45deg,
      var(--stone) 0 12px,
      var(--paper-warm) 12px 24px
    );
    color: var(--ink-soft);
    text-align: center;
    font-size: var(--step--1);
    min-height: 12rem;
  }

  .photo--empty span {
    display: grid;
    gap: 0.35rem;
    max-width: 30ch;
    padding: 0.8rem 1rem;
    background: color-mix(in srgb, var(--paper) 90%, transparent);
  }

  .photo--empty b {
    font-family: var(--font-display);
    font-size: var(--step-0);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--laterite);
  }
</style>
