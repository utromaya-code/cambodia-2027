<div class="sticky" id="sticky-cta" hidden>
  <a class="sticky__btn" href="#zayavka" data-analytics="hero_cta_click">
    Забронировать место
  </a>
</div>

<style>
  .sticky {
    position: fixed;
    inset: auto var(--gutter) calc(0.75rem + env(safe-area-inset-bottom)) auto;
    z-index: 50;
    display: block;
    transform: translateY(calc(100% + 2rem));
    transition: transform 0.3s ease;
  }

  .sticky.is-visible {
    transform: none;
  }

  .sticky__btn {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    padding: 0.72rem 1.15rem;
    background: var(--laterite);
    color: var(--paper);
    box-shadow: 0 0.45rem 1.4rem rgb(23 19 16 / 0.28);
    font-family: var(--font-display);
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    text-decoration: none;
    text-transform: uppercase;
  }

  @media (min-width: 60rem) {
    .sticky {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sticky {
      transition: none;
    }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('#sticky-cta');
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const form = document.querySelector<HTMLElement>('#zayavka');

  if (bar && hero) {
    bar.hidden = false;

    /* Кнопка появляется после первого экрана и прячется у самой формы */
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.target === hero) {
            bar.classList.toggle('is-visible', !entry.isIntersecting);
          }
          if (entry.target === form && entry.isIntersecting) {
            bar.classList.remove('is-visible');
          }
        }
      },
      { threshold: 0.05 },
    );

    observer.observe(hero);
    if (form) observer.observe(form);
  }
</script>
