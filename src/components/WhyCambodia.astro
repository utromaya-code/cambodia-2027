---
import Photo from './Photo.astro';
import { whyCambodia } from '../data/sections';
---

<section class="why section section--stone">
  <div class="wrap">
    <h2 class="section__title reveal">{whyCambodia.title}</h2>
    <p class="section__lead reveal">{whyCambodia.lead}</p>
  </div>

  <div class="wrap why__list">
    {
      whyCambodia.cards.map((card, i) => (
        <article class="why__card reveal">
          <Photo
            src={card.image}
            alt={card.text}
            class="why__photo"
            sizes="(min-width: 60rem) 52vw, 100vw"
            ratio={i % 2 === 0 ? '4 / 3' : '3 / 2'}
          />
          <div class="why__text">
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .why__list {
    display: grid;
    gap: clamp(2.5rem, 7vw, 5rem);
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  .why__card {
    display: grid;
    gap: 1.4rem;
  }

  .why__text h3 {
    font-size: var(--step-2);
    text-transform: uppercase;
  }

  .why__text p {
    max-width: 46ch;
    margin-top: 0.8rem;
    color: var(--ink-soft);
  }

  @media (min-width: 60rem) {
    .why__card {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 3rem;
      align-items: center;
    }

    /* Чётные карточки разворачиваем — страница не превращается в ровный список */
    .why__card:nth-child(even) > :global(.photo) {
      order: 2;
    }

    .why__text {
      padding-block: 1rem;
    }
  }
</style>
