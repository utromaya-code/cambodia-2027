---
import { faq as defaultFaq, type FaqItem } from '../data/faq';

interface Props {
  /** Список вопросов. По умолчанию — вопросы основного путешествия. */
  items?: readonly FaqItem[];
  title?: string;
}

const { items = defaultFaq, title = 'Вопросы' } = Astro.props;
---

<section class="faq section" id="voprosy">
  <div class="wrap wrap--narrow">
    <h2 class="section__title reveal">{title}</h2>

    <ul class="faq__list">
      {
        items.map((item, i) => (
          <li class="faq__item reveal">
            <h3>
              <button
                class="faq__q"
                type="button"
                aria-expanded="false"
                aria-controls={`faq-a-${i}`}
                id={`faq-q-${i}`}
              >
                <span>{item.q}</span>
                <span class="faq__sign" aria-hidden="true" />
              </button>
            </h3>
            <div class="faq__a" id={`faq-a-${i}`} role="region" aria-labelledby={`faq-q-${i}`} hidden>
              <p>{item.a}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .faq__list {
    margin-top: clamp(1.8rem, 4vw, 2.8rem);
  }

  .faq__item {
    border-top: 1px solid var(--rule);
  }

  .faq__item:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .faq__item h3 {
    margin: 0;
    font: inherit;
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: 100%;
    padding: 1.15rem 0;
    background: none;
    border: 0;
    text-align: left;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.25;
  }

  .faq__sign {
    position: relative;
    flex: none;
    width: 1rem;
    height: 1rem;
  }

  .faq__sign::before,
  .faq__sign::after {
    content: '';
    position: absolute;
    background: var(--laterite);
    inset: 50% 0 auto 0;
    height: 2px;
    translate: 0 -50%;
  }

  .faq__sign::after {
    inset: 0 50% auto auto;
    width: 2px;
    height: 100%;
    translate: 50% 0;
    transition: opacity 0.2s ease;
  }

  .faq__q[aria-expanded='true'] .faq__sign::after {
    opacity: 0;
  }

  .faq__a {
    padding-bottom: 1.3rem;
  }

  .faq__a p {
    max-width: 62ch;
    color: var(--ink-soft);
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.faq__q').forEach((btn) => {
    btn.addEventListener('click', () => {
      const panel = document.getElementById(btn.getAttribute('aria-controls')!);
      if (!panel) return;
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
    });
  });
</script>
