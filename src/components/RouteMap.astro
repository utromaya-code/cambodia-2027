---
import { routePoints, islandPoint } from '../data/route';
import { trip } from '../data/trip';

/**
 * Маршрут на настоящей карте.
 *
 * Здесь раньше стоял раскрывающийся список из десяти точек: у каждой —
 * абзац текста и мини-галерея. Он дублировал программу по дням, которая
 * идёт ниже и рассказывает то же самое подробнее, а на телефоне вообще
 * подменял собой карту: SVG-контур страны прятался на узких экранах.
 * Человек, открывший раздел «Маршрут», карты не видел вовсе.
 *
 * Теперь наоборот: карта — главное, а список под ней только называет
 * точки по порядку. Подробности остались в одном месте, в программе.
 *
 * Карта собирается на Leaflet поверх тайлов OpenStreetMap. Google Maps
 * Embed API требует ключ, которого у проекта нет; вместо встраивания
 * под картой стоит кнопка, открывающая тот же маршрут в самом Google Maps —
 * там его удобно посмотреть в приложении или отправить себе.
 *
 * Рисованный контур страны из src/data/cambodia-shape.ts больше не
 * используется — файл оставлен на случай, если понадобится вернуться
 * к схематичной карте.
 */

const points = routePoints.map((p, i) => ({
  n: i + 1,
  id: p.id,
  name: p.name,
  latin: p.latin,
  lat: p.lat,
  lon: p.lon,
  note: p.note,
}));

const island = {
  name: islandPoint.name,
  latin: islandPoint.latin,
  lat: islandPoint.lat,
  lon: islandPoint.lon,
};

/**
 * Ссылка на маршрут в Google Maps: /dir/ с координатами через слэш.
 * Ко Ронг сюда не добавляем — на остров идут по воде, и Google построил бы
 * несуществующую дорогу. Остров показан на нашей карте отдельной линией.
 */
const googleMapsUrl = `https://www.google.com/maps/dir/${points
  .map((p) => `${p.lat},${p.lon}`)
  .join('/')}`;

const mapData = JSON.stringify({ points, island });
---

<section class="route section section--dark" id="marshrut">
  <div class="wrap">
    <p class="kicker reveal">Маршрут</p>
    <h2 class="section__title reveal">С севера на юг, через всю страну</h2>
    <p class="section__lead reveal">
      Десять точек, десять дней и одна дорога — от храмов Ангкора до побережья.
    </p>
  </div>

  <!-- На широком экране карта и список идут в две колонки: маршрут вытянут
       с севера на юг, и в полную ширину карта оставляла бы по бокам пустоту
       шире самой страны. -->
  <div class="wrap route__layout">
    <div class="route__mapwrap reveal">
      <div class="route__map" id="route-map" data-route-map={mapData}></div>

      <!-- Пока карта не поднялась (или если скрипты выключены), на её месте
           видна подпись, а не пустой прямоугольник неизвестного назначения. -->
      <p class="route__mapfallback">Карта маршрута: {trip.start} → {trip.finish}</p>
    </div>

    <div class="route__actions reveal">
      <a
        class="route__gmaps"
        href={googleMapsUrl}
        target="_blank"
        rel="noopener"
        data-analytics="route_map_open"
      >
        Открыть маршрут в Google Maps
      </a>
      <p class="route__islandnote">
        Пунктиром — Ко Ронг: отдельная программа 8–15 марта, туда идут по воде.
      </p>
    </div>

    <!-- Порядок точек текстом. Он же — то, что видят поисковые системы
         и программы чтения с экрана: внутри карты для них ничего нет. -->
    <ol class="route__list reveal" aria-label="Точки маршрута по порядку">
      {
        points.map((p) => (
          <li class="route__item">
            <span class="route__index">{String(p.n).padStart(2, '0')}</span>
            <span class="route__name">{p.name}</span>
            <span class="route__latin">{p.latin}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .route__layout {
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  .route__mapwrap {
    position: relative;
    background: color-mix(in srgb, var(--paper) 8%, transparent);
    border: 1px solid var(--rule);
  }

  .route__map {
    height: clamp(22rem, 62svh, 34rem);
    /* Пока Leaflet не инициализирован, блок пустой и прозрачный —
       под ним читается запасная подпись. */
    position: relative;
    z-index: 1;
  }

  .route__mapfallback {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: grid;
    place-items: center;
    padding: 1rem;
    text-align: center;
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: color-mix(in srgb, var(--paper) 60%, transparent);
  }

  .route__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.6rem;
    margin-top: 1.2rem;
  }

  .route__gmaps {
    display: inline-flex;
    align-items: center;
    min-height: 2.9rem;
    padding: 0.6rem 1.3rem;
    border: 1px solid var(--accent);
    color: var(--accent);
    font-family: var(--font-display);
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .route__gmaps:hover,
  .route__gmaps:focus-visible {
    background: var(--accent);
    color: var(--ink);
  }

  .route__islandnote {
    max-width: 32ch;
    font-size: var(--step--1);
    color: color-mix(in srgb, var(--paper) 70%, transparent);
  }

  .route__list {
    display: grid;
    gap: 0.55rem;
    margin: clamp(1.8rem, 4vw, 2.6rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .route__item {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.8rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--rule);
  }

  .route__index {
    font-family: var(--font-display);
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    color: var(--accent);
  }

  .route__name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    text-transform: uppercase;
  }

  .route__latin {
    font-size: var(--step--1);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--paper) 65%, transparent);
  }

  @media (min-width: 48rem) and (max-width: 61.99rem) {
    .route__list {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.55rem 2.5rem;
    }
  }

  @media (min-width: 62rem) {
    .route__layout {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(16rem, 0.85fr);
      gap: 2.5rem 3rem;
      align-items: start;
    }

    /* Карта занимает левую колонку и обе строки, список и кнопка — правую */
    .route__mapwrap {
      grid-row: span 2;
      height: 100%;
    }

    .route__map {
      height: clamp(26rem, 68svh, 40rem);
    }

    .route__list {
      order: -1;
      margin-top: 0;
    }

    .route__actions {
      margin-top: 0;
      align-items: start;
      flex-direction: column;
    }
  }

  /*
   * Подложку задаём самому .route__map, а не через :global(.leaflet-container).
   * Leaflet вешает класс leaflet-container на тот же элемент, который ему
   * передали, — то есть на .route__map. Селектор-потомок ".route__map
   * .leaflet-container" не совпадал бы ни с чем, и под непрогрузившимися
   * тайлами оставался бы дефолтный серый прямоугольник Leaflet.
   */
  .route__map {
    background: var(--jungle);
    font-family: var(--font-body);
  }

  .route__map :global(.route-pin) {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--laterite);
    color: #fff;
    font-family: var(--font-display);
    font-size: 0.8rem;
    line-height: 1;
    box-shadow: 0 0 0 2px color-mix(in srgb, #fff 85%, transparent);
  }

  .route__map :global(.route-pin--island) {
    background: var(--sea-light);
    color: var(--ink);
  }

  .route__map :global(.leaflet-popup-content-wrap) {
    border-radius: 2px;
  }

  .route__map :global(.leaflet-popup-content) {
    margin: 0.7rem 0.9rem;
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .route__map :global(.route-popup__name) {
    display: block;
    font-family: var(--font-display);
    font-size: 1.05rem;
    text-transform: uppercase;
  }
</style>

<script>
  /**
   * Карта поднимается только когда до неё доскроллили: Leaflet вместе со
   * стилями весит заметно больше всего остального скрипта страницы, и
   * тянуть его ради раздела, до которого могут не дойти, незачем.
   */
  const el = document.querySelector<HTMLElement>('#route-map');

  interface MapPoint {
    n: number;
    name: string;
    latin: string;
    lat: number;
    lon: number;
    note: string;
  }

  if (el?.dataset.routeMap) {
    const { points, island } = JSON.parse(el.dataset.routeMap) as {
      points: MapPoint[];
      island: { name: string; latin: string; lat: number; lon: number };
    };

    let started = false;

    const boot = async () => {
      if (started) return;
      started = true;

      const [L] = await Promise.all([
        import('leaflet'),
        import('leaflet/dist/leaflet.css'),
      ]);

      const map = L.map(el, {
        scrollWheelZoom: false, // колесо должно листать страницу, а не зумить карту
        attributionControl: true,
        // Кнопки масштаба Leaflet подписывает по-английски, а страница русская:
        // подписи уходят и в title, и в aria-label кнопок.
        zoomControl: false,
      });

      L.control
        .zoom({ zoomInTitle: 'Приблизить', zoomOutTitle: 'Отдалить' })
        .addTo(map);

      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 18,
        attribution: '&copy; OpenStreetMap',
      }).addTo(map);

      const latlngs = points.map((p) => [p.lat, p.lon] as [number, number]);

      L.polyline(latlngs, { color: '#c8401d', weight: 4, opacity: 0.95 }).addTo(map);

      // Ко Ронг — пунктиром: это отдельная программа, и добираются туда по воде
      L.polyline(
        [latlngs[latlngs.length - 1], [island.lat, island.lon]],
        { color: '#46c3ac', weight: 3, dashArray: '6 8', opacity: 0.9 },
      ).addTo(map);

      const pin = (label: string, extra = '') =>
        L.divIcon({
          className: '',
          html: `<span class="route-pin ${extra}">${label}</span>`,
          iconSize: [28, 28],
          iconAnchor: [14, 14],
        });

      for (const p of points) {
        L.marker([p.lat, p.lon], { icon: pin(String(p.n)), title: p.name })
          .addTo(map)
          .bindPopup(
            `<span class="route-popup__name">${p.name}</span>${p.note}`,
          );
      }

      L.marker([island.lat, island.lon], {
        icon: pin('★', 'route-pin--island'),
        title: island.name,
      })
        .addTo(map)
        .bindPopup(
          `<span class="route-popup__name">${island.name}</span>Дополнительная программа 8–15 марта`,
        );

      const bounds = L.latLngBounds([...latlngs, [island.lat, island.lon]]);
      map.fitBounds(bounds, { padding: [36, 36] });

      /*
       * Карта поднимается за 200 px до появления на экране, и в этот момент
       * блок ещё может доезжать до своего конечного размера. Leaflet
       * запоминает габариты один раз, поэтому после смены размера ему нужно
       * сказать пересчитать их — иначе часть тайлов не запрашивается.
       */
      const refit = () => {
        map.invalidateSize({ animate: false });
        map.fitBounds(bounds, { padding: [36, 36] });
      };
      requestAnimationFrame(refit);
      new ResizeObserver(() => map.invalidateSize({ animate: false })).observe(el);
    };

    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          void boot();
        }
      },
      { rootMargin: '200px' },
    );
    io.observe(el);
  }
</script>
