---
import Photo from './Photo.astro';
import { retreat } from '../data/retreat';
import { isReady } from '../data/content';

const { hero, facts } = retreat;

/** Показываем только подтверждённые факты — остальные просто не выводим. */
const readyFacts = facts.filter((f) => isReady(f.value));
---

<header class="rhero" data-retreat-hero>
  <div class="rhero__media">
    <Photo
      src={retreat.heroImage}
      alt={retreat.heroAlt}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      widths={[640, 1000, 1400, 1900, 2400]}
      quality={72}
    />
  </div>

  <div class="rhero__inner wrap">
    <div class="rhero__plate">
      <p class="rhero__kicker">{hero.kicker}</p>
      <h1 class="rhero__title">{hero.title}</h1>
      <p class="rhero__lead">{hero.lead}</p>

      <div class="rhero__actions">
        <a class="btn rhero__cta" href="#zayavka" data-analytics="retreat_cta">{hero.cta}</a>
        <a class="rhero__link" href={`#${retreat.rhythm.id}`}>{hero.ctaSecondary}</a>
      </div>

      {
        readyFacts.length > 0 && (
          <dl class="rhero__facts">
            {readyFacts.map((fact) => (
              <div class="rhero__fact">
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </div>
</header>

<style>
  .rhero {
    position: relative;
    display: grid;
    align-content: end;
    min-height: 92svh;
    padding-block: clamp(4.5rem, 12vh, 8rem) clamp(1.5rem, 5vh, 3.5rem);
    color: #fff;
    background: var(--sea);
    overflow: hidden;
  }

  .rhero__media {
    position: absolute;
    inset: 0;
  }

  .rhero__media :global(.photo) {
    height: 100%;
  }

  /*
    Общего затемнения здесь почти нет — и это осознанно.
    Прошлый вариант держал контраст градиентом на весь кадр, и приходилось
    выбирать: либо белые буквы читаются, либо вода остаётся бирюзовой.
    На этом снимке светлое лежит внизу, ровно под текстом, поэтому выбор был
    бы в пользу тёмного кадра. Контраст даёт плашка под текстом, а плёнка
    поверх фотографии нужна только чтобы связать кадр с цветом плашки.
  */
  .rhero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(4 26 31 / 0.34) 0%,
      rgb(4 26 31 / 0.16) 45%,
      rgb(4 26 31 / 0.04) 78%,
      rgb(4 26 31 / 0.14) 100%
    );
  }

  .rhero__inner {
    position: relative;
    z-index: 1;
  }

  /* Печатная плашка, а не «стекло»: плотный цвет, прямые углы, без блюра. */
  .rhero__plate {
    max-width: 40rem;
    padding: clamp(1.3rem, 4vw, 2.2rem) clamp(1.2rem, 3.5vw, 2.2rem)
      clamp(1rem, 3vw, 1.6rem);
    background: rgb(5 31 35 / 0.9);
  }

  .rhero__kicker {
    margin: 0 0 0.8rem;
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #ffd9a0;
  }

  .rhero__title {
    font-size: var(--step-4);
    text-transform: uppercase;
    line-height: 0.96;
  }

  .rhero__lead {
    max-width: 34ch;
    margin-top: 1.1rem;
    font-size: var(--step-1);
    line-height: 1.45;
    color: color-mix(in srgb, #fff 90%, transparent);
  }

  .rhero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.6rem;
    margin-top: 1.7rem;
  }

  .rhero__cta {
    width: 100%;
    background: #fff;
    color: var(--sea);
  }

  .rhero__cta:hover {
    background: #ffe9c9;
  }

  .rhero__link {
    color: #fff;
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, #fff 55%, transparent);
    padding-bottom: 0.2rem;
  }

  .rhero__link:hover {
    border-bottom-color: #fff;
  }

  /* Факты — подпись под плакатом, внутри той же плашки */
  .rhero__facts {
    display: grid;
    gap: 0;
    margin: 1.6rem 0 0;
    border-top: 1px solid color-mix(in srgb, #fff 28%, transparent);
  }

  .rhero__fact {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    padding-block: 0.65rem;
  }

  .rhero__fact + .rhero__fact {
    border-top: 1px solid color-mix(in srgb, #fff 16%, transparent);
  }

  .rhero__fact dt {
    flex: none;
    min-width: 5.5rem;
    font-size: var(--step--1);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    /* 62% давали 4,3:1 на плашке — подняли до порога */
    color: color-mix(in srgb, #fff 74%, transparent);
  }

  .rhero__fact dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-0);
    line-height: 1.25;
  }

  @media (min-width: 40rem) {
    .rhero__cta {
      width: auto;
    }
  }

  @media (min-width: 62rem) {
    .rhero__plate {
      /* Чуть шире: иначе «Леонид Кутузов и Илья Баринов» ломается пополам */
      max-width: 45rem;
    }

    .rhero__title {
      font-size: var(--step-5);
      line-height: 0.94;
    }

    .rhero__facts {
      grid-template-columns: repeat(2, 1fr);
      gap: 0 2rem;
    }

    .rhero__fact:nth-child(2) {
      border-top: 0;
    }

    .rhero__fact dd {
      font-size: var(--step-1);
    }
  }
</style>
