---
import { pricing } from '../data/pricing';

const [moto, road] = pricing.options;

/**
 * Компактная навигация и sticky CTA — пункт 7 ТЗ.
 *
 * Панель появляется после того, как первый экран уходит из виду, и держится
 * сверху до конца страницы. Кнопка заявки внутри неё гаснет, когда посетитель
 * доехал до самой формы: предлагать перейти туда, где он уже стоит, незачем.
 *
 * Полноэкранного мобильного меню здесь нет намеренно — разделов шесть, и
 * горизонтальная лента с прокруткой показывает их быстрее, чем кнопка,
 * открывающая оверлей. Заодно не приходится ловить фокус внутри модалки.
 */
const links = [
  { href: '#marshrut', label: 'Маршрут' },
  { href: '#programma', label: 'Программа' },
  { href: '#vedushchie', label: 'Команда' },
  { href: '#stoimost', label: 'Стоимость' },
  { href: '#ostrov', label: 'Остров' },
  { href: '#voprosy', label: 'Вопросы' },
];
---

<div class="nav" id="site-nav" hidden>
  <nav class="nav__inner" aria-label="Разделы страницы">
    <ul class="nav__links">
      {
        links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>

    <a class="nav__cta" href="#zayavka" data-analytics="price_cta_click">
      <span class="nav__price">
        {road.priceHuman}—{moto.priceHuman}
      </span>
      <span class="nav__ctaText">Оставить заявку</span>
    </a>
  </nav>
</div>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 60;
    background: var(--ink);
    color: var(--paper);
    border-bottom: 1px solid color-mix(in srgb, var(--paper) 16%, transparent);
    /* Не заезжаем под «чёлку» в ландшафтной ориентации */
    padding-top: env(safe-area-inset-top);
    transform: translateY(-100%);
    transition: transform 0.28s ease;
  }

  .nav.is-visible {
    transform: none;
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: min(100% - var(--gutter) * 2, 90rem);
    margin-inline: auto;
    padding-block: 0.55rem;
  }

  .nav__links {
    display: flex;
    gap: 1.2rem;
    margin: 0;
    padding: 0;
    list-style: none;
    /* На узком экране разделы не влезают в строку — уводим в ленту */
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .nav__links::-webkit-scrollbar {
    display: none;
  }

  /* Подсказка, что лента прокручивается: последний пункт растворяется
     у правого края, а не обрывается на середине слова. */
  @media (max-width: 59.99rem) {
    .nav__links {
      mask-image: linear-gradient(to right, #000 82%, transparent 100%);
    }
  }

  .nav__links a {
    display: block;
    padding-block: 0.35rem;
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    text-decoration: none;
    color: color-mix(in srgb, var(--paper) 82%, transparent);
    border-bottom: 2px solid transparent;
  }

  .nav__links a:hover,
  .nav__links a:focus-visible {
    color: var(--paper);
    border-bottom-color: var(--marker);
  }

  .nav__cta {
    display: none;
    flex: none;
    align-items: baseline;
    gap: 0.7rem;
    margin-left: auto;
    padding: 0.5rem 1.1rem;
    background: var(--laterite);
    color: var(--paper);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav__cta:hover {
    background: var(--marker);
    color: var(--ink);
  }

  .nav__price {
    font-family: var(--font-display);
  }

  /*
   * Кнопку в панели показываем только на широком экране. На телефоне за
   * заявку отвечает нижняя липкая кнопка под большим пальцем — две кнопки
   * одновременно отобрали бы у ленты разделов почти всю ширину.
   */
  @media (min-width: 60rem) {
    .nav__cta {
      display: inline-flex;
    }

    .nav__links {
      gap: 1.8rem;
    }
  }

  /* Панель скрыта до конца первого экрана, но у формы кнопка гаснет */
  .nav.is-at-form .nav__cta {
    visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav {
      transition: none;
    }
  }
</style>

<script>
  /**
   * Панель показывается, когда первый экран вышел из виду.
   *
   * Селектор — [data-hero], а не .hero: класса .hero в разметке первого
   * экрана нет, он собран на утилитарных классах. Нижняя липкая кнопка
   * искала именно .hero, не находила и потому не показывалась вообще.
   */
  const nav = document.querySelector<HTMLElement>('#site-nav');
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const form = document.querySelector<HTMLElement>('#zayavka');

  if (nav && hero) {
    nav.hidden = false;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.target === hero) {
            nav.classList.toggle('is-visible', !entry.isIntersecting);
          }
          if (entry.target === form) {
            nav.classList.toggle('is-at-form', entry.isIntersecting);
          }
        }
      },
      { threshold: 0.05 },
    );

    observer.observe(hero);
    if (form) observer.observe(form);
  }
</script>
