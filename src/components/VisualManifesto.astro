---
import { getImage } from 'astro:assets';
import Photo from './Photo.astro';
import { manifesto } from '../data/trip';
import { getPhoto } from '../data/images';

/**
 * Графический блок-мост между героем и объяснением (TripIntro) — раздел 03
 * брифа: гигантская типографика, числа, дорога, фрагменты фото, а не обычная
 * text-секция. «Зачёркивание» негативных формулировок анимируется через уже
 * существующий механизм .reveal/is-visible (src/scripts/reveal.ts) — отдельный
 * скрипт не нужен, prefers-reduced-motion уже уважается глобально.
 *
 * Фон — размытые башни Ангкора в утренней дымке. Экран занимает всю высоту
 * окна и до этого был пустым бежевым полем с несколькими строками. Размытие
 * сделано на сборке (bg-manifesto.jpg), не фильтром в браузере.
 */
const bg = getPhoto('bg-manifesto');
const bgUrl = bg ? (await getImage({ src: bg, width: 1400, format: 'webp' })).src : null;
---

<section
  class="manifesto section section--stone"
  aria-label="Что это за путешествие"
  style={bgUrl ? `--bg-image:url(${bgUrl})` : undefined}
>
  <div class="wrap manifesto__inner">
    <p class="manifesto__opening">
      {
        manifesto.opening.map((line, i) => (
          <span
            class="manifesto__word reveal"
            style={`transition-delay:${i * 120}ms`}
          >
            {line}
          </span>
        ))
      }
    </p>

    <div class="manifesto__statement reveal">
      <span class="manifesto__number">{manifesto.statementNumber}</span>
      <div class="manifesto__statement-lines">
        {manifesto.statementLines.map((line) => <p>{line}</p>)}
      </div>
    </div>

    <div class="manifesto__poetic reveal">
      {manifesto.poetic.map((line) => <p>{line}</p>)}
    </div>
  </div>

  <!-- Фрагменты фото — акцент, не иллюстрация: два маленьких кадра задают
       полюса маршрута, между которыми проходит поездка, — лес наверху
       и вода внизу.

       Обёртка здесь обязательна. Классы компоновки нельзя вешать прямо на
       <Photo>: scoped-стили Astro метят только элементы собственного
       шаблона, а корневой div дочернего компонента получает его же скоуп,
       а не родительский. Правила .manifesto__fragment компилировались с
       чужим хешем и не применялись вовсе — оба кадра просто лежали в
       потоке справа от текста и на мобильном налезали на заголовок. -->
  <div class="manifesto__fragment manifesto__fragment--road reveal">
    <Photo
      src="angkor-thom-naga"
      alt="Каменная голова наги у дороги гигантов, ведущей к воротам Ангкор-Тхома"
      ratio="3 / 4"
      sizes="180px"
      widths={[240, 360]}
    />
  </div>
  <!-- Два каменных фрагмента вместо прежней пары «река в джунглях + лик»:
       снимок реки с воздуха был из самых тёмных в библиотеке (яркость 84 при
       среднем 110) и в мелком фрагменте читался чёрным пятном. Нага у дороги
       гигантов и лик Байона держат первое слово манифеста — «Храмы» — и оба
       сняты в ясный день. -->
  <div class="manifesto__fragment manifesto__fragment--bike reveal">
    <Photo
      src="bayon-face"
      alt="Каменный лик на башне храма Байон на фоне синего неба"
      ratio="4 / 5"
      sizes="200px"
      widths={[280, 400]}
    />
  </div>
</section>

<style>
  .manifesto {
    position: relative;
    isolation: isolate;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-block: clamp(4rem, 10vh, 7rem);
    overflow: clip;
  }

  /* Прозрачность та же, что и в TripIntro: выше 0.24 тёмный текст на
     бумаге начинает терять контраст на светлых участках кадра. */
  .manifesto::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: var(--bg-image);
    background-size: cover;
    background-position: center;
    opacity: 0.24;
  }

  .manifesto__inner {
    position: relative;
    z-index: 1;
  }

  /* Три слова маршрута: средний размер — контраст с гигантским statement ниже.
     Зачёркивание, которое было здесь раньше, ушло вместе с отрицаниями:
     перечёркнутое «Храмы. Дорога. Море.» означало бы ровно обратное тому,
     что говорит секция. Проявление осталось на сайтовом .reveal. */
  .manifesto__opening {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em 1.2em;
  }

  .manifesto__word {
    display: inline-block;
    font-family: var(--font-display);
    font-size: var(--step-2);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--laterite-ink);
  }

  .manifesto__statement {
    display: flex;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 0.3em 0.6em;
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
  }

  .manifesto__number {
    font-family: var(--font-display);
    font-size: clamp(5rem, 3rem + 14vw, 15rem);
    line-height: 0.85;
    color: var(--laterite);
  }

  .manifesto__statement-lines {
    display: grid;
    padding-bottom: 0.15em;
  }

  .manifesto__statement-lines p {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.05;
    text-transform: uppercase;
  }

  .manifesto__poetic {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    max-width: 34ch;
  }

  .manifesto__poetic p {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .manifesto__poetic p + p {
    margin-top: 0.2em;
  }

  /* Фрагменты фото — акцентные обломки кадра, не иллюстрации к тексту */
  .manifesto__fragment {
    display: none;
    position: absolute;
    width: 8rem;
    box-shadow: 0 1.5rem 3rem -1rem rgb(0 0 0 / 0.35);
  }

  .manifesto__fragment--road {
    top: 8%;
    right: 8%;
    rotate: 4deg;
  }

  .manifesto__fragment--bike {
    bottom: 6%;
    right: 16%;
    width: 7rem;
    rotate: -3deg;
  }

  @media (min-width: 60rem) {
    .manifesto__fragment {
      display: block;
    }
  }
</style>
